	public static void puntoMedio(Cardinal c1, Cardinal c2) {
		int pos1= c1.ordinal();
		int pos2= c2.ordinal();
		
		if(c1.isOpposite(c2)) {
			System.out.println("I punti cardinali sono opposti");
			return;
		}
			
		
		int distance = Math.abs(pos1-pos2);
		
		if(distance > 8) {
			if(pos1<pos2) {
				pos1+= 16;
			}else {
				pos2+=16;
			}
