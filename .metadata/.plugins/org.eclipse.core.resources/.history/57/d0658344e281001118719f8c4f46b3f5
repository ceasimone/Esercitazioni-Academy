package esercizio8;

public class Main {
	

	public static void main(String[] args) {
		Studente s= new Studente("Mario", "Rossi", 33);
		s.studia();
		System.out.println(s);
		s.calcolaMediaVoti(6.5,5.0,8.5,7.5);
		System.out.println(s);
		
		Insegnante i= new Insegnante("Luigi", "Bianchi", 45, "Inglese");
		i.insegna();
		System.out.println(i);
		
		lezione(s);
		lezione(i);
	}
	
	public static void lezione(Persona p) {
		if(p instanceof Studente) {
			Studente s = (Studente) p;
			s.studia();
		}else {
			Insegnante i= (Insegnante) p;
			i.insegna();
		}
	}

}
