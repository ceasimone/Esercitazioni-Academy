package esercizio1;

import java.util.ArrayList;
import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		ArrayList< Integer > valori = new ArrayList<>();
		Scanner input = new Scanner(System.in);
		
		try {
			
			System.out.println("Inserisci il primo valore");
			int valore=input.nextInt();
			valori.add(valore);
		
		
			while(true) {
				System.out.println("Inserisci il secondo valore");
				valore=input.nextInt();
				valori.add(valore);
				if( valori.get(valori.size()-1)< valori.get(valori.size()-2)) {
					break;
				}
				
			}
			
		} catch(Exception e) {
			 System.out.println("Errore: inserire solo numeri interi.");
		}
		
		
		System.out.println("Numeri inseriti: " + valori);

	}

}
