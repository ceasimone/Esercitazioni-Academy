package esercizio5;

import java.util.Random;

public class Gara {
	private String nomeGara;
	private Pilota[] persone;
	private Pilota[] griglia;
	
	
	
	public Gara() {
		
	}
	
	public Gara(String nomeGara, Pilota[] persone) {
		this.nomeGara=nomeGara;
		this.persone=persone;
		this.griglia= new Pilota[persone.length];
	}
	
	public void stampaPiloti() {
		System.out.println("I PILOTI PARTECIPANTI ALLA GARA SONO:");
		for( Pilota val: persone) {
			System.out.println(val) ;
		}
	}
	
	public void creaGrigliaDiPartenza() {
		Random random= new Random();
		boolean[] usati = new boolean[persone.length];
		for(int i=0; i<persone.length;i++) {
			int j ;
			do {
				j= random.nextInt(persone.length);
			} while(usati[j]);
			griglia[i] = persone[j];
			usati[j]=true;
		}
	}
	
	public void stampaGrigliaDiPartenza() {
		System.out.println("I NOMI DEI PILOTI SONO IN ORDINE DI POSIZIONE NELLA GRIGLIA:");
		for( Pilota val: griglia) {
			System.out.println(val) ;
		}
		
	}
	
	public void corriGara() {
		Random random= new Random();
		int vincitore= random.nextInt(griglia.length);
		System.out.println("IL VINCITORE DELLA GARA: " + this.nomeGara + " E': " + griglia(vincitore).getNome() + "\n\n INFORMAZIONI VINCITORE:\n" + griglia(vincitore));
	}
	

}
