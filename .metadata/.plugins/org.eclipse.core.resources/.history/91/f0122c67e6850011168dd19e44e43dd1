package progettoselenium;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class Main {

	public static void main(String[] args) {
		
		try {
			// Serve per avviare il brower Google Chrome tramite Selenium, in modo che
			// il programma Java posso controllarlo automaticamente
			// setProperty -> serve a impostare le proprietà dei sistema
			// "webdrive.chrome.driver" -> nome della proprietà di sistema
			// "C:\\......." -> il percorso del file eseguibile chromedriver.exe
			System.setProperty("webdrive.chrome.driver",
					"C:\\Users\\Bcsoft\\Desktop\\chromedriver-win64\\chromedriver-win64\\chromedriver.exe");

			// WebDriver -> l'interfaccia di Selenium
			// ChromeDriver -> la classe concreta che implementa l'interfaccia WebDriver
			WebDriver driver = new ChromeDriver(); // new FirefoxDriver(); //new EdgeDriver();

			// get() -> permette di aprire una pagina web specificando l'URL
			driver.get("http://www.google.com");

			// Thread.sleep() -> serve a mettere in pausa per 3 secondi
			Thread.sleep(3000);

			// getTitle() -> restitutisce il titolo della pagina web caricata
			String titolo = driver.getTitle();
			System.out.println("Il titolo è " + titolo);

			// simile a get() apre la pagina sulla stessa scheda
			driver.navigate().to("http://www.google.com/maps");
			
			Thread.sleep(3000);
			
			//torna alla pagina precedente, torna indietro nella cronologia
			driver.navigate().back();
			
			Thread.sleep(3000);
			//va alla pagina successiva, va avanti nella cronologia
			driver.navigate().forward();
			Thread.sleep(3000);
			
			//ricarica la pagina, fare F5
			driver.navigate().refresh();
			
			Thread.sleep(3000);
			
			//massimizzare
			driver.manage().window().maximize();
			Thread.sleep(3000);
			//minimizzare, riduce a icona
			driver.manage().window().minimize();
			Thread.sleep(3000);
			
			//a tutto schermo
			driver.manage().window().fullscreen();
			Thread.sleep(3000);
			
			
			//impostare la posizione della finestra, distanza dai bordi
			driver.manage().window().setPosition(new Point(200, 500));
			Thread.sleep(3000);
			//ridimensionare la pagina, la finistra avrà altezza 500 e larghezza 500
			driver.manage().window().setSize(new Dimension(500, 500));
			
			Thread.sleep(3000);
		}

		//InterruptedException -> indica che un thread è stato interrotto
		//metre stava aspettando/dormendo
		catch (InterruptedException e) {
			e.printStackTrace();
		}
	}
}
