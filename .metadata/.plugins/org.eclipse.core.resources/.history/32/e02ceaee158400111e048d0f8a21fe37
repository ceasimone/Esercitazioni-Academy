package esercizio1;

import java.util.ArrayList;
import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		ArrayList< Integer > numeri = new ArrayList<>();
		Scanner input = new Scanner(System.in);
		while(true) {
			try {
			
				System.out.println("Inserisci il primo valore");
				int valore=input.nextInt();
				numeri.add(valore);
		
		
				while(true) {
					try {
						System.out.println("Inserisci valore");
				
						valore=input.nextInt();
						numeri.add(valore);
						
						if( numeri.get(numeri.size()-1)> numeri.get(numeri.size()-2))
							numeri.removeLast();
							break;
						
						
						
					}catch(Exception e) {
							System.out.println("Errore: inserire solo numeri interi.");
							input.nextLine();
						}
				
				}
				
				break;
			
			} catch(Exception e) {
				
				System.out.println("Errore: inserire solo numeri interi.");
				input.nextLine();
			 
			}
		}
		
		
		input.close();
		int somma=0;
		
		for(int num: numeri) {
			somma+=num;
		}
		
		double media= (double) somma/numeri.size();
		
		System.out.println("Numeri inseriti: " + numeri.size());
        System.out.println("Media: " + media);
        System.out.println("Valori: " + numeri);

	}

}
